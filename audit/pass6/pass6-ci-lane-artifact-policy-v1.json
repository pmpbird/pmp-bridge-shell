{
  "type": "PMP_PASS6_CI_LANE_ARTIFACT_POLICY_V1",
  "version": "1.0.0",
  "pass": 6,
  "unit": "P6-U5",
  "policy": {
    "missing_required_check": "FAIL_CLOSED",
    "missing_artifact": "FAIL_CLOSED",
    "scope_mismatch": "FAIL_CLOSED",
    "flake_detected": "FAIL_CLOSED_AND_PRESERVE_ALL_ATTEMPTS",
    "automatic_retry": "FORBIDDEN",
    "failed_attempt_erasure": "FORBIDDEN",
    "special_lane_retry": "FORBIDDEN_WITHOUT_NEW_EXPLICIT_AUTHORITY",
    "green_requires": "ONE_COMPLETE_DETERMINISTIC_PASSING_ATTEMPT_WITH_ALL_CHECKS_AND_ARTIFACTS"
  },
  "required_checks": [
    "exact_scope",
    "source_identity",
    "deterministic_tests",
    "evidence_manifest",
    "artifact_manifest",
    "receipt"
  ],
  "artifact_roles": [
    "command",
    "stdout",
    "stderr",
    "exit_status",
    "result",
    "scope",
    "environment",
    "authority_state",
    "manifest"
  ],
  "artifact_contract": {
